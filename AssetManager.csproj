<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Deficuet.$(AssemblyName)</PackageId>
    <Title>Deficuet.AssetManager</Title>
    <Version>0.0.1-alpha.1</Version>
    <Authors>Deficuet</Authors>
    <Company />
    <Description>An asset manager without Unity env</Description>
    <PackageProjectUrl>https://github.com/Deficuet/AsserManager</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Deficuet/AsserManager</RepositoryUrl>
    <PackageTags>PolyType</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolyType" Version="2.0.0-rc.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
