<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Deficuet.$(AssemblyName)</PackageId>
    <Title>Deficuet.AssetManager</Title>
    <Version>0.0.1-alpha.4</Version>
    <Authors>Deficuet</Authors>
    <Company />
    <Description>An asset manager without Unity env</Description>
    <PackageProjectUrl>https://github.com/Deficuet/AsserManager</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Deficuet/AsserManager</RepositoryUrl>
    <PackageTags>PolyType</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deficuet.AssetsTools.NET" Version="3.0.5-alpha.1" />
    <PackageReference Include="Deficuet.AssetsTools.NET.Cpp2IL" Version="3.0.4-alpha.1" />
    <PackageReference Include="PolyType" Version="2.0.0-rc.4">
      <PrivateAssets>
        contentFiles;build;buildMultitargeting;buildTransitive
      </PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
